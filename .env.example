# Application
PORT=3000
NODE_ENV=development
INSTANCE_ID=instance-1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=jungle
DB_PASSWORD=jungle_secret
DB_NAME=jungle_wagering

# AWS SQS (LocalStack / MiniStack)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-integration-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_POLL_ENABLED=true

# Background Workers
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

PENDING_REF_POLL_INTERVAL_MS=250
PENDING_REF_MAX_ATTEMPTS=8
PENDING_REF_BASE_DELAY_MS=100

# Authentication Extension Point (set AUTH_MODE=oidc to enforce external IdP validation)
AUTH_MODE=noop
OIDC_ISSUER_URL=http://localhost:8080/realms/jungle-gaming
