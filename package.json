{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Jungle Gaming Technical Challenge — Distributed Wagering Processor",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "migration:up": "bun run src/infrastructure/database/cli-migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/cli-migrate.ts down",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 60000",
    "test:all": "bun test test/unit test/integration test/concurrency --timeout 60000",
    "test:load": "bun run scripts/load-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/migrations": "^6.4.3",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@nestjs/testing": "^10.4.15",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.2"
  }
}
